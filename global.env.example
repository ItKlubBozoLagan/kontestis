# The following two are optional
#   for development, docker-compose will spin up a local evaluator
#   leave commented in development or when function authorization is undesired
#GOOGLE_EVALUATOR_SERVICE_ACCOUNT_EMAIL=aaaa-bbbb@xxxx.iam.gserviceaccount.com
#GOOGLE_EVALUATOR_SERVICE_ACCOUNT_PRIVATE_KEY_BASE64=LS0tLS1CRUdJTiBQUklWQVRFIEtFWS0tLS0tCm1pc2xpcwotLS0tLUVORCBQUklWQVRFIEtFWS0tLS0tCg==

JWT_SECRET=xxxx

# Required in production; Prometheus sends this as a bearer token to GET /metrics.
METRICS_BEARER_TOKEN=replace-with-a-long-random-value

# Private Grafana embedding. Production should mount an RS256 private key at this path and
# configure Grafana with the corresponding public key and the X-Kontestis-Grafana-JWT header.
GRAFANA_EMBED_ENABLED=false
#GRAFANA_INTERNAL_URL=http://grafana:3000
#GRAFANA_PUBLIC_URL=https://api.example.com/grafana
#GRAFANA_JWT_PRIVATE_KEY_PATH=/run/secrets/kontestis-grafana-private.pem
