# The following two are optional
#   for development, docker-compose will spin up a local evaluator
#   leave commented in development or when function authorization is undesired
#GOOGLE_EVALUATOR_SERVICE_ACCOUNT_EMAIL=aaaa-bbbb@xxxx.iam.gserviceaccount.com
#GOOGLE_EVALUATOR_SERVICE_ACCOUNT_PRIVATE_KEY_BASE64=LS0tLS1CRUdJTiBQUklWQVRFIEtFWS0tLS0tCm1pc2xpcwotLS0tLUVORCBQUklWQVRFIEtFWS0tLS0tCg==

JWT_SECRET=xxxx

# Current evaluator messaging (the legacy HTTP evaluator still uses EVALUATOR_ENDPOINT)
NATS_SERVERS=nats://nats:4222
NATS_EVALUATION_NAMESPACE=kontestis.evaluation.v1
EVALUATION_NATS_OBJECT_THRESHOLD_BYTES=16777216
NATS_EVALUATION_OBJECT_MAX_BYTES=2147483648
NATS_EVALUATION_QUEUE_MAX_BYTES=10737418240
NATS_EVALUATION_REPLICAS=1
NATS_EVALUATION_RESPONSE_TIMEOUT_MILLIS=518400000
NATS_EVALUATION_FILE_RETRY_LIMIT=5
S3_EVALUATOR_INSTANCE_URL=http://minio:9000
