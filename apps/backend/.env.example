MODE=development
PORT=8080
DB_HOST=scylla
DB_PORT=9042
DB_KEYSPACE=kontestis
DB_DATACENTER=datacenter1
DATABASE_URL=postgresql://kontestis:kontestis@postgres:5432/kontestis
SCYLLA_MIGRATION_ENABLED=true
DATABASE_MIGRATION_BATCH_SIZE=500
# DB_PREPROVISIONED=true
# DB_USERNAME=kontestis
# DB_PASSWORD=replace-me
REDIS_URL=redis://redis:6379
OAUTH_CLIENT_ID=xxx.apps.googleusercontent.com
# External applications that may sign users in through kontestis (OAuth 2.0 authorization code
# flow, see src/lib/oauthProvider.ts). secret_sha256 is the hex SHA-256 of the client secret:
#   secret=$(openssl rand -base64 32); printf %s "$secret" | sha256sum
# OAUTH_PROVIDER_CLIENTS=[{"id":"example","name":"Example","secret_sha256":"<64 hex>","redirect_uris":["https://example.com/auth/callback"]}]
EVALUATOR_ENDPOINT=http://127.0.0.1:8081

EMAIL_HOST=localhost
EMAIL_PORT=465
EMAIL_ACCOUNT_MAIL=test@example.com
EMAIL_ACCOUNT_DISPLAY_NAME=Kontestis
EMAIL_ACCOUNT_PASSWORD=pass123

DEFAULT_ORGANISATION_NAME=Kontestis
