# Backend origin; "/api" is appended automatically.
VITE_API_ENDPOINT=http://localhost:8080
# Google Identity Services client id (Google login is hidden when unset).
VITE_OAUTH_CLIENT_ID=
# reCAPTCHA v3 site key used for email login/registration.
VITE_CAPTCHA_SITE_KEY=
VITE_AAI_EDU_LOGOUT_URL=https://login.aaiedu.hr/sso/module.php/oidc/logout.php
VITE_AAI_EDU_LOGOUT_REDIRECT_URL=http://localhost:3100/
